#version 450

struct Sphere{
    vec4 center;
    vec4 color;
};

struct Vertex{
    vec4 position;
    vec4 color;
    vec4 normal;
};

struct Triangle{
    Vertex[3] vertices;
};

struct Light{
    vec4 position;
    vec4 color;
};

layout (set = 0, binding = 0, rgba8) uniform writeonly image2D outImage;

layout (set = 0, binding = 1, rgba8) uniform image2D accumImagePrev;
layout (set = 0, binding = 2, rgba8) uniform image2D accumImage;

layout (std430, set = 1, binding = 0) buffer sphereSSBO{
    Sphere spheres [];
};

layout (std430, set = 1, binding = 1) buffer vertexSSBO{
    Vertex vertices [];
};

layout (std430, set = 1, binding = 2) buffer indexSSBO{
    uint indices [];
};

layout (std430, set = 2, binding = 0) buffer lightSSBO{
    Light lights [];
};

layout(push_constant) uniform CameraObject {
    vec4 up;
    vec4 forward;
    vec4 right;
    vec4 position;
    vec4 utils;
} camera;

layout (local_size_x = 8, local_size_y = 8) in;

struct Ray{
    vec3 origin;
    vec3 direction;
    vec3 accumulatedColor;
    uint numBounces;
};

#define MAX_BOUNCES 20
#define RAYS_PER_PIXEL 64
#define SAMPLE_COUNT 100
#define PI 3.14159265

bool hit(Ray ray, Sphere sphere, out float tHit);
float hash(vec2 p);
float rand(vec2 p);
vec3 randomHemisphereDirection(vec3 normal, vec2 seed);
vec3 randomSphere(vec2 seed);
bool hitTriangle(Ray ray, Triangle triangle, out float tHit, out float u, out float v);
vec3 rayTraceColor(float horizontalCoefficient, float verticalCoefficient, vec2 screenPos);
vec3 testTrace(float horizontalCoefficient, float verticalCoefficient, vec2 screenPos);
vec3 calculateLambertLighting(vec3 hitPoint, vec3 hitColor, vec3 normal);

void main() {

    ivec2 screenPos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screenSize = imageSize(outImage);

    float aspect = float(screenSize.x) / float(screenSize.y);

    float horizontalCoefficient = (float(screenPos.x) + 0.5) / float(screenSize.x) * 2.0 - 1.0; 
    horizontalCoefficient *= aspect;

    float verticalCoefficient   = 1.0 - (float(screenPos.y) + 0.5) / float(screenSize.y) * 2.0;

    vec3 pixelColor = rayTraceColor(horizontalCoefficient, verticalCoefficient, screenPos);//testTrace(horizontalCoefficient, verticalCoefficient, screenPos);

    vec4 oldColor = imageLoad(accumImagePrev, screenPos);
    vec3 accumulated;
    
    if(camera.utils.y != 0.0){
        accumulated = (oldColor.rgb * (camera.utils.z - 1) + pixelColor) / camera.utils.z;
    }else{
        accumulated = pixelColor * 5.0;
    }

    imageStore(accumImage, screenPos, vec4(accumulated, 1.0));
    imageStore(outImage, screenPos, vec4(accumulated, 1.0));
}

bool hit(Ray ray, Sphere sphere, out float tHit){
    vec3 oc = ray.origin - sphere.center.xyz;
    float a = dot(ray.direction, ray.direction);
    float b = 2.0 * dot(oc, ray.direction);
    float c = dot(oc, oc) - sphere.center.w * sphere.center.w;

    float discriminant = b*b - 4.0*a*c;
    if (discriminant < 0.0) return false;

    float sqrtDisc = sqrt(discriminant);
    float t0 = (-b - sqrtDisc) / (2.0 * a);
    float t1 = (-b + sqrtDisc) / (2.0 * a);

    t0 = max(t0, 0.0);
    t1 = max(t1, 0.0);

    tHit = min(t0, t1);
    return tHit > 0.0;
}

float hash(vec2 p)
{
    uint x = floatBitsToUint(p.x);
    uint y = floatBitsToUint(p.y);
    uint n = x * 374761393u + y * 668265263u;
    n = (n ^ (n >> 13u)) * 1274126177u;
    return float(n & 0x00ffffffu) / float(0x01000000u);
}

float rand(vec2 p)
{
    return fract(sin(dot(p.xy ,vec2(12.9898,78.233)) + camera.utils.x) * 43758.5453) * 0.5;
}

vec3 randomHemisphereDirection(vec3 normal, vec2 seed)
{
    vec2 seed1 = seed + vec2(camera.utils.x, camera.utils.x*1.3);
    vec2 seed2 = seed + vec2(camera.utils.x*2.1, camera.utils.x*3.7);

    float r1 = rand(seed1);
    float r2 = rand(seed2);

    float r = sqrt(r1);
    float theta = 2.0 * 3.14159265 * r2;

    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(1.0 - r*r);

vec3 localDir = vec3(x, y, z);

    vec3 up = abs(normal.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    return normalize(
        tangent * localDir.x +
        bitangent * localDir.y +
        normal * localDir.z
    );
}

vec3 randomSphere(vec2 seed)
{
    float u1 = rand(seed);
    float u2 = rand(seed + vec2(1.2345, 6.789));

    float z = 1.0 - 2.0 * u1;
    float phi = 2.0 * 3.14159265 * u2;

    float r = sqrt(max(0.0, 1.0 - z*z));

    float x = r * cos(phi);
    float y = r * sin(phi);

    return vec3(x, y, z);
}

bool hitTriangle(Ray ray, Triangle triangle, out float tHit, out float u, out float v){

    vec3 v0 = triangle.vertices[0].position.xyz;
    vec3 v1 = triangle.vertices[1].position.xyz;
    vec3 v2 = triangle.vertices[2].position.xyz;

    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;

    vec3 h = cross(ray.direction, edge2);
    float a = dot(edge1, h);

    if (abs(a) < 1e-6)
        return false;

    float f = 1.0 / a;
    vec3 s = ray.origin - v0;

    u = f * dot(s, h);
    if (u < 0.0 || u > 1.0)
        return false;

    vec3 q = cross(s, edge1);
    v = f * dot(ray.direction, q);
    if (v < 0.0 || u + v > 1.0)
        return false;

    tHit = f * dot(edge2, q);

    return tHit > 0.0;

}

vec3 rayTraceColor(float horizontalCoefficient, float verticalCoefficient, vec2 screenPos){

    vec3 pixelColor = vec3(0.0,0.0,0.0);

    vec3 forward = camera.forward.xyz;
    vec3 right   = camera.right.xyz;
    vec3 up      = camera.up.xyz;

    float fov = radians(75.0);
    float fovScale = tan(fov * 0.5);

    int numSpheres = spheres.length();
    int numLights = lights.length();
    int numTriangles = indices.length() / 3;

    for(int rayNum=0; rayNum<RAYS_PER_PIXEL; rayNum++){

        Ray ray;
        ray.origin = camera.position.xyz;

        vec3 rayDir = normalize(forward + horizontalCoefficient * fovScale * right + verticalCoefficient   * fovScale * up);

        vec2 jitter = vec2(rand(screenPos + vec2(camera.utils.x)), rand(screenPos + vec2(camera.utils.x * 0.3 + 1.0))) * 0.01;

        ray.direction = normalize(rayDir + vec3(jitter, 0.0));
        ray.accumulatedColor = vec3(0.0);
        ray.numBounces = 0;

        vec3 throughput = vec3(1.0);
        vec3 radiance = vec3(0.0);
    
        for(int bounce = 0; bounce < MAX_BOUNCES; bounce++){

            bool hitSomething = false;
            bool hitLight = false;

            float minT = 1e30;
            vec3 hitColor;
            uint closestSphereIndex;

            vec3 hitPoint;
            vec3 normal;

            for(int i=0; i<numTriangles; i++){
                
                float tHit;
                vec2 uv = vec2(0.0);

                Triangle tri;
                tri.vertices[0] = vertices[indices[i * 3]];
                tri.vertices[1] = vertices[indices[i * 3 + 1]];
                tri.vertices[2] = vertices[indices[i * 3 + 2]];

                if(hitTriangle(ray, tri, tHit, uv.x, uv.y) && tHit < minT){
                    minT = tHit;
                    hitColor = vec3(0.2,0.2,0.2);
                    hitSomething = true;
                    normal = normalize(
                        (1.0 - uv.x - uv.y) * tri.vertices[0].normal.xyz +
                        uv.x * tri.vertices[1].normal.xyz +
                        uv.y * tri.vertices[2].normal.xyz
                    );
                }
            }

            for(int i=0; i<numSpheres; i++){
                float tHit;
                if(hit(ray, spheres[i], tHit) && tHit < minT){
                    minT = tHit;
                    hitColor = spheres[i].color.xyz;
                    hitSomething = true;
                    hitLight = false;
                    
                    hitPoint = ray.origin + ray.direction * minT;
                    normal   = normalize(hitPoint - spheres[i].center.xyz);
                }
            }

            for(int i=0; i<numLights; i++){
                Sphere lightSphere;
                lightSphere.center = lights[i].position;
                lightSphere.color = lights[i].color;

                float tHit;
                if(hit(ray, lightSphere, tHit) && tHit < minT){
                    minT = tHit;
                    hitColor = lights[i].color.xyz * lights[i].color.w;
                    hitSomething = true;
                    hitLight = true;
                }
            }

            if(!hitSomething)
                break;

            if(hitLight){
                radiance += throughput * hitColor;
                break;
            }

            radiance += throughput * calculateLambertLighting(hitPoint, hitColor, normal);
            throughput *= hitColor;

            vec2 seed = screenPos + vec2(bounce * 1.2);
            float r = rand(seed);

            vec3 newDir;

            
            if (r < 0.08) 
            {
                int lightIndex = int(floor(rand(seed+vec2(1.0)) * float(numLights)));
                Light light = lights[lightIndex];

                vec3 lightPoint = light.position.xyz + light.position.w * randomSphere(seed);

                vec3 toLight = lightPoint - hitPoint;
                float lightDist = length(toLight);
                newDir = toLight / lightDist;

                if (dot(normal, newDir) <= 0.0)
                    return vec3(0.0);
            }
            else 
            {
                newDir = randomHemisphereDirection(normal, screenPos + vec2(bounce, camera.utils.x));
            }

            ray.origin = hitPoint + normal * 0.0001;
            ray.direction = newDir;
        }

        
        pixelColor += radiance;
        
    }

    return pixelColor / RAYS_PER_PIXEL;
}

vec3 calculateLambertLighting(vec3 hitPoint, vec3 hitColor, vec3 normal){
    
    int numLights = lights.length();

    vec3 totalRadiance = vec3(0.0);

    for(int i = 0; i < numLights; i++)
    {
        vec3 toLight = lights[i].position.xyz - hitPoint;
        float dist = length(toLight);
        vec3 lightDir = normalize(toLight);

        float attenuation = 1.0 / (dist * dist + 0.1);
        float NdotL = max(dot(normal, lightDir), 0.0);

        totalRadiance += lights[i].color.xyz * lights[i].color.w *
                    attenuation *
                    NdotL;
    }

    vec3 finalColor = hitColor * totalRadiance / 3.14159265;

    return finalColor;

}