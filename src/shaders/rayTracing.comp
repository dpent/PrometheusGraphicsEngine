#version 450

struct Vertex{
    vec4 position;
    vec4 normal;
};

struct Triangle{
    ivec4 vertices; // 0, 1, 2, matIndex
};

struct Material{
    vec4 color;
    vec4 properties; // x: type
};

struct BVHNode{
    ivec4 childIndices;
    vec4 minBounds;
    vec4 maxBounds;
};

struct TLASNode{
    ivec4 nodeIndices;
    vec4 minBounds;
    vec4 maxBounds;
};

layout (set = 0, binding = 0, rgba8) uniform writeonly image2D outImage;

layout (set = 0, binding = 1, rgba8) uniform image2D accumImagePrev;
layout (set = 0, binding = 2, rgba8) uniform image2D accumImage;

layout (std430, set = 1, binding = 0) buffer materialSSBO{
    Material materials [];
};

layout (std430, set = 1, binding = 1) buffer vertexSSBO{
    Vertex vertices [];
};

layout (std430, set = 1, binding = 2) buffer triangleSSBO{
    Triangle triangles [];
};

layout (std430, set = 1, binding = 3) buffer bvhSSBO{
    BVHNode nodes [];
};

layout (std430, set = 1, binding = 4) buffer tlasSSBO{
    TLASNode tlasNodes [];
};

layout(push_constant) uniform CameraObject {
    vec4 up;
    vec4 forward;
    vec4 right;
    vec4 position;
    vec4 utils;
} camera;

layout (local_size_x = 8, local_size_y = 8) in;

struct Ray{
    vec3 origin;
    vec3 direction;
};

struct HitRecord {
    vec3 p;
    vec3 normal;
    vec3 albedo;
    uint matIndex;
};

#define MAX_BOUNCES 4
#define RAYS_PER_PIXEL 8
#define SAMPLE_COUNT 100
#define PI 3.14159265
#define STACK_DEPTH 2048

#define MATERIAL_LAMBERT 0
#define MATERIAL_LIGHT 1
#define MATERIAL_METAL 2
#define MATERIAL_DIELECTRIC 3

uint numMaterials = materials.length();
uint numVertices = vertices.length();
uint numTriangles = triangles.length();
uint numTLASNodes = tlasNodes.length();

uint rngState =
    uint(gl_GlobalInvocationID.x) * 1973u +
    uint(gl_GlobalInvocationID.y) * 9277u +
    uint(camera.utils.z) * 26699u +
    911u;

float rand(vec2 p)
{
    return fract(sin(dot(p.xy ,vec2(12.9898,78.233)) + camera.utils.x) * 43758.5453) * 0.5;
}

vec3 randomHemisphereDirection(vec3 normal, vec2 seed)
{
    vec2 seed1 = seed + vec2(camera.utils.x, camera.utils.x*1.3);
    vec2 seed2 = seed + vec2(camera.utils.x*2.1, camera.utils.x*3.7);

    float r1 = rand(seed1);
    float r2 = rand(seed2);

    float r = sqrt(r1);
    float theta = 2.0 * 3.14159265 * r2;

    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(1.0 - r*r);

vec3 localDir = vec3(x, y, z);

    vec3 up = abs(normal.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    return normalize(
        tangent * localDir.x +
        bitangent * localDir.y +
        normal * localDir.z
    );
}

vec3 randomSphere(vec2 seed)
{
    float u1 = rand(seed);
    float u2 = rand(seed + vec2(1.2345, 6.789));

    float z = 1.0 - 2.0 * u1;
    float phi = 2.0 * 3.14159265 * u2;

    float r = sqrt(max(0.0, 1.0 - z*z));

    float x = r * cos(phi);
    float y = r * sin(phi);

    return vec3(x, y, z);
}

void handleTriangleCheck(Ray ray, uint triangleIndex, inout float minT, inout HitRecord hitRec, inout bool hitSomething){
    
    Triangle triangle = triangles[triangleIndex];

    vec3 v0 = vertices[triangle.vertices.x].position.xyz;
    vec3 v1 = vertices[triangle.vertices.y].position.xyz;
    vec3 v2 = vertices[triangle.vertices.z].position.xyz;

    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;

    vec3 h = cross(ray.direction, edge2);
    float a = dot(edge1, h);

    // avoid division by very small numbers
    float maskA = step(1e-6, abs(a));   // 0 if |a| < 1e-6

    float f = 1.0 / a;
    vec3 s = ray.origin - v0;

    vec2 uv;

    uv.x = f * dot(s, h);
    float maskU = step(0.0, uv.x) * step(uv.x, 1.0);

    vec3 q = cross(s, edge1);
    uv.y = f * dot(ray.direction, q);
    float maskV = step(0.0, uv.y) * step(uv.y, 1.0 - uv.x);

    float tHit = f * dot(edge2, q);

    float maskT = step(0.0, tHit);  // tHit > 0

    // multiply all masks to get final hit
    if(!((maskA * maskU * maskV * maskT) > 0.0 && tHit < minT)){
        
        return;
    }

    minT = tHit;
    hitRec.p = ray.origin + ray.direction * tHit;
    hitRec.albedo = materials[triangle.vertices.w].color.xyz;
    hitSomething = true;
    hitRec.normal = normalize(
        (1.0 - uv.x - uv.y) * vertices[triangle.vertices.x].normal.xyz +
        uv.x * vertices[triangle.vertices.y].normal.xyz +
        uv.y * vertices[triangle.vertices.z].normal.xyz
    );
    hitRec.matIndex = triangle.vertices.w;
}

vec3 orenNayarBRDF(vec3 albedo, vec3 normal, vec3 wi, vec3 wo, float sigma){ // wi is incoming dir, wo is outgoing, sigma is roughness
    float sigma2 = sigma * sigma;
    float A = 1.0 - (sigma2 / (2.0 * (sigma2 + 0.33)));
    float B = 0.45 * sigma2 / (sigma2 + 0.09);

    float cosThetaI = max(dot(normal, wi), 0.0);
    float cosThetaO = max(dot(normal, wo), 0.0);

    float alpha = max(acos(cosThetaI), acos(cosThetaO));
    float beta  = min(acos(cosThetaI), acos(cosThetaO));

    vec3 vi = normalize(wi - normal * cosThetaI);
    vec3 vo = normalize(wo - normal * cosThetaO);
    float gamma = max(0.0, dot(vi, vo));

    return albedo / PI * (A + B * gamma * sin(alpha) * tan(beta));
}

vec3 lambertThroughput(vec3 brdf, float cosTheta){
    
    float pdf = cosTheta / PI; //PDF for new dir

    return (brdf * cosTheta) / pdf;
}

bool intersectAABB(vec3 minBounds, vec3 maxBounds, vec3 rayOrigin, vec3 invDir, bvec3 dirNeg, out float dist){
    
    float txmin = ((dirNeg.x ? maxBounds.x : minBounds.x) - rayOrigin.x) * invDir.x;
    float txmax = ((dirNeg.x ? minBounds.x : maxBounds.x) - rayOrigin.x) * invDir.x;

    float tymin = ((dirNeg.y ? maxBounds.y : minBounds.y) - rayOrigin.y) * invDir.y;
    float tymax = ((dirNeg.y ? minBounds.y : maxBounds.y) - rayOrigin.y) * invDir.y;

    float tmin = max(txmin, tymin);
    float tmax = min(txmax, tymax);

    float tzmin = ((dirNeg.z ? maxBounds.z : minBounds.z) - rayOrigin.z) * invDir.z;
    float tzmax = ((dirNeg.z ? minBounds.z : maxBounds.z) - rayOrigin.z) * invDir.z;

    tmin = max(tmin, tzmin);
    tmax = min(tmax, tzmax);

    dist = tmin;

    return tmax >= max(tmin, 0.0);
}

vec3 getBoxNormal(vec3 p, vec3 minB, vec3 maxB)
{
    const float eps = 0.0001;

    if(abs(p.x - minB.x) < eps) return vec3(-1,0,0);
    if(abs(p.x - maxB.x) < eps) return vec3( 1,0,0);

    if(abs(p.y - minB.y) < eps) return vec3(0,-1,0);
    if(abs(p.y - maxB.y) < eps) return vec3(0, 1,0);

    if(abs(p.z - minB.z) < eps) return vec3(0,0,-1);

    return vec3(0,0,1);
}

bool hitScene(inout HitRecord hitRec, Ray ray) {

    vec3 invDir = 1.0 / ray.direction;
    bvec3 dirNeg = lessThan(ray.direction, vec3(0.0));
    uint stack[STACK_DEPTH];
    int stackPtr = 0; // Last node index in stack. If you have 2 nodes in, the value will be 2-1 = 1

    float minT = 1e30;
    bool hitSomething = false;

    uint tlasStack[STACK_DEPTH];
    int tlasStackPtr = 0;
    tlasStack[0] = 0;

    while(tlasStackPtr > -1){
        
        uint tlasIndex = tlasStack[tlasStackPtr--];

        float tEnter;

        TLASNode tlasNode = tlasNodes[tlasIndex];

        if(tlasNode.nodeIndices.z != 0){
            
            uint left  = tlasNode.nodeIndices.z;
            uint right = tlasNode.nodeIndices.w;

            float tLeft, tRight;
            bool hitLeft  = intersectAABB(tlasNodes[tlasNode.nodeIndices.z].minBounds.xyz, tlasNodes[tlasNode.nodeIndices.z].maxBounds.xyz, ray.origin, invDir, dirNeg, tLeft)  && tLeft  < minT;
            bool hitRight = intersectAABB(tlasNodes[tlasNode.nodeIndices.w].minBounds.xyz, tlasNodes[tlasNode.nodeIndices.w].maxBounds.xyz, ray.origin, invDir, dirNeg, tRight) && tRight < minT;

            bool swap = tRight < tLeft;

            uint nearChild = swap ? right : left;
            uint farChild  = swap ? left  : right;

            if(hitLeft && hitRight)
            {
                tlasStack[++tlasStackPtr] = farChild;
                tlasStack[++tlasStackPtr] = nearChild;
            }
            else if(hitLeft || hitRight)
            {
                tlasStack[++tlasStackPtr] = hitLeft ? left : right;
            }
        }else{
            
            stack[0] = tlasNode.nodeIndices.x;
            stackPtr = 0;

            while(stackPtr > -1){
        
                uint index = stack[stackPtr--];

                BVHNode node = nodes[index];

                if(node.childIndices.x == -1){ //leaf node
            
                    uint firstTriangle = node.childIndices.z;
                    uint numTrianglesToTest = node.childIndices.w;

                    for(uint j=firstTriangle; j<firstTriangle + numTrianglesToTest; j++){
                
                       handleTriangleCheck(ray, j, minT, hitRec, hitSomething);
                    }
                }else{ //internal node

                    uint left  = node.childIndices.x;
                    uint right = node.childIndices.y;

                    float tLeft, tRight;
                    bool hitLeft  = intersectAABB(nodes[node.childIndices.x].minBounds.xyz, nodes[node.childIndices.x].maxBounds.xyz, ray.origin, invDir, dirNeg, tLeft)  && tLeft  < minT;
                    bool hitRight = intersectAABB(nodes[node.childIndices.y].minBounds.xyz, nodes[node.childIndices.y].maxBounds.xyz, ray.origin, invDir, dirNeg, tRight) && tRight < minT;

                    bool swap = tRight < tLeft;

                    uint nearChild = swap ? right : left;
                    uint farChild  = swap ? left  : right;

                    if(hitLeft && hitRight)
                    {
                        stack[++stackPtr] = farChild;
                        stack[++stackPtr] = nearChild;
                    }
                    else if(hitLeft || hitRight)
                    {
                        stack[++stackPtr] = hitLeft ? left : right;
                    }

                }
            }
        }
    }

    return hitSomething;
}

vec3 metalBRDF(vec3 albedo){
    return albedo;
}

vec3 metalThroughput(vec3 brdf){
    
    return brdf;
}

void buildONB(vec3 n, out vec3 u, out vec3 v, out vec3 w)
{
    w = normalize(n);
    vec3 a = abs(w.x) > 0.9 ? vec3(0,1,0) : vec3(1,0,0);
    v = normalize(cross(w, a));
    u = cross(w, v);
}

vec3 toWorld(vec3 localDir, vec3 normal)
{
    vec3 u, v, w;
    buildONB(normal, u, v, w);
    return normalize(localDir.x * u + localDir.y * v + localDir.z * w);
}

float random(inout uint state)
{
    state = state * 747796405u + 1u;
    uint word = ((state >> ((state >> 28) + 4)) ^ state) * 277803737u;
    word = (word >> 22) ^ word;
    return float(word) / 4294967295.0;
}

vec3 randomCosineDirection(inout uint rng)
{
    float r1 = random(rng);
    float r2 = random(rng);

    float phi = 2.0 * PI * r1;

    float x = cos(phi) * sqrt(r2);
    float y = sin(phi) * sqrt(r2);
    float z = sqrt(1.0 - r2);

    return vec3(x, y, z);
}

vec3 scatterAndCalculateThroughput(HitRecord rec, inout Ray ray){

    Material mat = materials[rec.matIndex];
    
    if(mat.properties.x == MATERIAL_LAMBERT)
    {
        vec3 localDir = randomCosineDirection(rngState); //Choose random direction in the normal's hemisphere (closer to normal)
        vec3 newDir = toWorld(localDir, rec.normal);

        float cosTheta = max(dot(rec.normal, newDir), 0.0); //Light new direction angle cosine
        vec3 brdf = orenNayarBRDF(rec.albedo, rec.normal, -ray.direction, newDir, mat.properties.y);

        ray.origin = rec.p + rec.normal * 0.0001;
        ray.direction = newDir;

        return lambertThroughput(brdf, cosTheta);

    }else if(mat.properties.x == MATERIAL_METAL)
    {
        vec3 newDir = normalize(reflect(ray.direction, rec.normal) + mat.properties.y * randomSphere(vec2(camera.utils.x, camera.utils.z)));

        vec3 brdf = metalBRDF(rec.albedo);

        ray.origin = rec.p + rec.normal * 0.0001;
        ray.direction = newDir;

        return metalThroughput(brdf);
    }
}

vec2 sampleDisk(vec2 r)
{
    float theta = 2.0 * 3.14159265 * r.x;
    float radius = sqrt(r.y);
    return radius * vec2(cos(theta), sin(theta));
}

vec3 rayTraceColor(float horizontalCoefficient, float verticalCoefficient, vec2 screenPos, uint raysPerPixel){

    vec3 pixelColor = vec3(0.0,0.0,0.0);

    vec3 forward = camera.forward.xyz;
    vec3 right   = camera.right.xyz;
    vec3 up      = camera.up.xyz;

    float fov = radians(75.0);
    float fovScale = tan(fov * 0.5);

    float focalDistance = 5.0;   // distance where things are sharp
    float aperture = 0.01;       // lens radius (bigger = more blur)

    for(int rayNum=0; rayNum<raysPerPixel; rayNum++){

        Ray ray;
        ray.origin = camera.position.xyz;

        vec3 rayDir = normalize(
            forward +
            horizontalCoefficient * fovScale * right +
            verticalCoefficient   * fovScale * up
        );

        vec3 focusPoint = camera.position.xyz + rayDir * focalDistance;

        vec2 r = vec2(
            rand(screenPos + vec2(rayNum * 13.1)),
            rand(screenPos + vec2(rayNum * 7.7))
        );

        vec2 lens = aperture * sampleDisk(r);

        vec3 lensOffset = right * lens.x + up * lens.y;

        ray.origin = camera.position.xyz + lensOffset;
        ray.direction = normalize(focusPoint - ray.origin);

        vec3 radiance = vec3(0.0);
        vec3 throughput = vec3(1.0);

    
        for(int bounce = -1; bounce < MAX_BOUNCES; bounce++){

            HitRecord rec;

            if(!hitScene(rec, ray))
                break;

            if(materials[rec.matIndex].properties.x == MATERIAL_LIGHT) //Add the emission since only lights emit
            {
                radiance += throughput * rec.albedo * materials[rec.matIndex].color.w;
                break;
            }

            if(dot(rec.normal, ray.direction) > 0.0){
                break;
            }

            throughput *= scatterAndCalculateThroughput(rec, ray);
            
        }
        
        pixelColor += radiance;
        
    }

    return pixelColor / raysPerPixel;
}

void main() {

    ivec2 screenPos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screenSize = imageSize(outImage);

    float aspect = float(screenSize.x) / float(screenSize.y);

    float horizontalCoefficient = (float(screenPos.x) + 0.5) / float(screenSize.x) * 2.0 - 1.0; 
    horizontalCoefficient *= aspect;

    float verticalCoefficient   = 1.0 - (float(screenPos.y) + 0.5) / float(screenSize.y) * 2.0;
    
    vec3 accumulated;
    vec3 pixelColor;

    if(camera.utils.y != 0.0){

        pixelColor = rayTraceColor(horizontalCoefficient, verticalCoefficient, screenPos, RAYS_PER_PIXEL);
        vec4 oldColor = imageLoad(accumImagePrev, screenPos);
        accumulated = (oldColor.rgb * (camera.utils.z - 1) + pixelColor) / camera.utils.z;
    }else{
        
        pixelColor = rayTraceColor(horizontalCoefficient, verticalCoefficient, screenPos, 1);
        accumulated = pixelColor * 5.0;
    }

    imageStore(accumImage, screenPos, vec4(accumulated, 1.0));
    imageStore(outImage, screenPos, vec4(accumulated, 1.0));
}